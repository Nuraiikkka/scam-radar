# Copy to backend/.env for running without Docker. Every variable starts with SCAMRADAR_.
# Lists are written as JSON, for example ["a", "b"].

# local, test or prod. prod refuses to start without a strong secret key.
SCAMRADAR_ENV=local
SCAMRADAR_APP_NAME=Scam Radar
SCAMRADAR_DEBUG=false

# PostgreSQL in Docker and production. Tests use SQLite automatically.
SCAMRADAR_DATABASE_URL=postgresql+psycopg://scamradar:scamradar@localhost:5432/scamradar
SCAMRADAR_REDIS_URL=redis://localhost:6379/0
# true runs analyses inside the request. Only for tests.
SCAMRADAR_CELERY_ALWAYS_EAGER=false

# JWT signing key. Generate with: openssl rand -hex 32
SCAMRADAR_SECRET_KEY=change-me
SCAMRADAR_ACCESS_TOKEN_MINUTES=30
SCAMRADAR_REFRESH_TOKEN_DAYS=14
SCAMRADAR_JWT_ALGORITHM=HS256

# Admin account created or promoted at API start. Leave empty to skip.
SCAMRADAR_ADMIN_EMAIL=
SCAMRADAR_ADMIN_PASSWORD=

# Web origins allowed to call the API from a browser.
SCAMRADAR_CORS_ORIGINS=["http://localhost:8080"]
# true only behind Nginx or Caddy, so the real client IP is used for rate limits.
SCAMRADAR_TRUST_PROXY_HEADERS=false

# redis in Docker and production, memory for tests.
SCAMRADAR_RATE_LIMIT_STORAGE=redis
SCAMRADAR_RATE_LIMIT_ANONYMOUS_PER_HOUR=10
SCAMRADAR_RATE_LIMIT_USER_PER_HOUR=60
SCAMRADAR_RATE_LIMIT_AUTH_PER_HOUR=30

# Upload and video limits.
SCAMRADAR_MAX_UPLOAD_MB=60
SCAMRADAR_MAX_VIDEO_SECONDS=180
SCAMRADAR_ALLOWED_VIDEO_EXTENSIONS=[".mp4", ".mov", ".webm", ".mkv", ".m4v"]
SCAMRADAR_ALLOWED_URL_HOSTS=["tiktok.com", "www.tiktok.com", "m.tiktok.com", "vm.tiktok.com", "vt.tiktok.com"]

# Download settings for yt-dlp.
SCAMRADAR_DOWNLOAD_TIMEOUT_SECONDS=60
SCAMRADAR_DOWNLOAD_RETRIES=2

# Folders. In Docker these point to volumes.
SCAMRADAR_MEDIA_DIR=media
SCAMRADAR_LOGS_DIR=logs
SCAMRADAR_MODEL_CACHE_DIR=model_cache
# 0 deletes uploaded videos right after the analysis. More keeps them that many hours.
SCAMRADAR_VIDEO_RETENTION_HOURS=0
SCAMRADAR_CLEANUP_INTERVAL_MINUTES=30

# Speech to text. Sizes: tiny, base, small, medium. base is a good CPU default.
SCAMRADAR_WHISPER_MODEL_SIZE=base
SCAMRADAR_WHISPER_DEVICE=cpu
SCAMRADAR_WHISPER_COMPUTE_TYPE=int8
SCAMRADAR_WHISPER_ENABLED=true

# Text on screen.
SCAMRADAR_OCR_ENABLED=true
SCAMRADAR_OCR_LANGUAGES=["ru", "en"]
SCAMRADAR_OCR_GPU=false
SCAMRADAR_FRAME_INTERVAL_SECONDS=2.0
SCAMRADAR_MAX_FRAMES=12
SCAMRADAR_FRAME_MAX_WIDTH=720

# Text classifier file made by backend/ml/train_text.py.
SCAMRADAR_TEXT_MODEL_PATH=ml/models/text_model_latest.joblib

# Fusion of text and vision scores. Below the threshold the category is none.
SCAMRADAR_FUSION_TEXT_WEIGHT=0.6
SCAMRADAR_FUSION_VISION_WEIGHT=0.4
SCAMRADAR_FUSION_NONE_THRESHOLD=0.35

# Worker settings.
SCAMRADAR_WORKER_CONCURRENCY=2
SCAMRADAR_QUEUE_TIMEOUT_MINUTES=20
SCAMRADAR_TASK_TIME_LIMIT_SECONDS=600

# Used only by the Docker entrypoint.
SCAMRADAR_API_WORKERS=2
